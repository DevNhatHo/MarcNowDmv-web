# The Next.js Route Handler reads this server-only origin.
API_BASE_URL=http://localhost:8080
# Browser requests stay on the frontend origin; no backend CORS change required.
NEXT_PUBLIC_API_BASE_URL=/api/backend

# Map basemap (WEB-MAP-6, MapLibre GL JS).
#
# The chosen starting point is a vector basemap that needs NO API KEY, so there is normally
# nothing to set here and no account or billing relationship at all. If a provider requiring
# a key is adopted instead, add it as an empty NEXT_PUBLIC_* variable here and set the real
# value in .env.local.
#
# A NEXT_PUBLIC_ key reaches the browser and is PUBLIC BY DESIGN: protect it with a referrer
# restriction in the provider's console, never by trying to hide it. Never commit a real key.
#
# With no basemap configured, /map degrades to its text equivalent rather than showing a
# broken canvas.
# NEXT_PUBLIC_MAP_STYLE_URL=
